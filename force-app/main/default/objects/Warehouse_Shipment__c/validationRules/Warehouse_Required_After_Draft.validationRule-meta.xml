<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Warehouse_Required_After_Draft</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    NOT(ISPICKVAL(Status__c, &quot;Draft&quot;)),
    ISBLANK(Warehouse__c)
)</errorConditionFormula>
    <errorDisplayField>Warehouse__c</errorDisplayField>
    <errorMessage>Select a Warehouse before moving the shipment out of Draft.</errorMessage>
</ValidationRule>
